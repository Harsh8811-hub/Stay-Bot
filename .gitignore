# Replay artifacts. Each run writes a transcript of a real conversation — the same guest
# text and phone numbers the corpus holds — so they are scratch, not source.
tools/replay/runs/

# Eval run output and recorded cassettes. A cassette is a transcript by another name: it
# stores the head of every prompt sent to Gemini, which is guest text and the system
# prompt. Ignored by contents, not by directory, so a baseline that *should* be committed
# (phase 3's CI gate) can be re-included with a `!evals/cassettes/<name>/` line.
evals/runs/
evals/cassettes/*

# macOS
.DS_Store

DOCS-SHARED/*
PVT-NOTES/*
PVT-DOCS/*
.claude/*

